{
  "constitution_id": "omega-cvr-constitution",
  "version": "1.0.0",
  "title": "CVR Constitution – EMV / ISO 7816 Profile",
  "runtime_profile": "emv-iso7816",
  "hash_algorithm": "sha256",
  "principles": [
    "Single source of truth: the Constitution",
    "All artifacts are pure deterministic projections of the Kernel",
    "Every transformation is witnessed and replayable",
    "Multi-view consistency is enforced by discrete sheaf cohomology (H¹ = 0)",
    "No handwritten configuration outside constitution/"
  ],
  "invariants": [
    "deterministic_execution",
    "pure_transformations",
    "witness_completeness",
    "replay_identity",
    "artifact_hash_stability",
    "sheaf_consistency"
  ],
  "admissibility": {
    "operators_must_be_pure": true,
    "operators_must_be_deterministic": true,
    "every_node_requires_witness": true,
    "every_node_must_support_replay": true
  },
  "profiles": {
    "iso7816": {
      "description": "Base ISO/IEC 7816 smart-card command set",
      "required": true
    },
    "emv": {
      "description": "EMV contact chip transaction flow",
      "required": true,
      "depends_on": ["iso7816"]
    }
  },
  "operators": [
    {
      "id": "iso7816.select",
      "name": "SELECT",
      "cla": "00",
      "ins": "A4",
      "description": "Select file or application"
    },
    {
      "id": "iso7816.read_record",
      "name": "READ RECORD",
      "cla": "00",
      "ins": "B2",
      "description": "Read a record from a linear or cyclic file"
    },
    {
      "id": "iso7816.get_processing_options",
      "name": "GET PROCESSING OPTIONS",
      "cla": "80",
      "ins": "A8",
      "description": "EMV Get Processing Options"
    },
    {
      "id": "iso7816.generate_ac",
      "name": "GENERATE AC",
      "cla": "80",
      "ins": "AE",
      "description": "EMV Generate Application Cryptogram"
    }
  ],
  "environment": {
    "java": "21",
    "python": "3.12",
    "android_sdk": "pinned",
    "gradle": "pinned"
  }
}
